# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or Atlas)
# Example Local: mongodb://127.0.0.1:27017/ai_lead_reactivator
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_lead_reactivator?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ai_lead_reactivator

# Allowed CORS Origins (comma separated)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================
# 🤖 GOOGLE GEMINI AI — Required for AI Chat & Email features
# ============================================================
# Get your FREE API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# 📧 EMAIL / SMTP Configuration (optional in development)
# ============================================================
# If NOT set, emails are sent to Ethereal (test mode — check console for preview URL)
# For Gmail: use App Password (https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASS=your_app_password_here
# EMAIL_FROM_NAME=AI Lead Reactivator
